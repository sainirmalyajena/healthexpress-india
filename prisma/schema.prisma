generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Surgery {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  category        Category
  overview        String
  indications     String
  procedure       String
  duration        String
  hospitalStay    String
  recovery        String
  risks           String
  preparation     String
  postOpCare      String
  costRangeMin    Int
  costRangeMax    Int
  insuranceLikely Boolean      @default(false)
  symptoms        String[]
  availableCities String[]     @default([])
  faqs            Json         @default("[]")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  metaDescription String?
  leads           Lead[]
  socialPosts     SocialPost[]
  doctors         Doctor[]     @relation("DoctorToSurgery")
}

model Hospital {
  id              String   @id @default(cuid())
  name            String
  city            String
  specialties     String[]
  discountPercent Float    @default(0)
  email           String   @unique
  passwordHash    String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  doctors         Doctor[]
  leads           Lead[]
}

model Doctor {
  id             String    @id @default(cuid())
  name           String
  qualification  String
  experience     Int
  about          String
  image          String
  isVerified     Boolean   @default(false)
  accreditations String[]  @default([])
  email          String    @unique
  passwordHash   String?
  status         String    @default("ACTIVE")
  availability   Json      @default("{}")
  hospitalId     String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  hospital       Hospital  @relation(fields: [hospitalId], references: [id])
  surgeries      Surgery[] @relation("DoctorToSurgery")
}

model Lead {
  id             String          @id @default(cuid())
  fullName       String
  phone          String
  email          String?
  city           String
  surgeryId      String?
  hospitalId     String?
  description    String
  insurance      InsuranceOption @default(NO)
  hasCard        Boolean         @default(false)
  isEmergency    Boolean         @default(false)
  callbackTime   String?
  status         LeadStatus      @default(NEW)
  notes          String?
  opdDate        DateTime?
  originalCost   Float?
  discountedCost Float?
  revenue        Float?
  sourcePage     String
  utmSource      String?
  utmCampaign    String?
  utmMedium      String?
  utmTerm        String?
  utmContent     String?
  referenceId    String          @unique
  otp            String?
  otpExpires     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  rating         Int?
  feedback       String?
  assignedUserId String?
  followUpDate   DateTime?
  firstContactedAt DateTime?
  documents      Document[]
  activityLogs   ActivityLog[]
  hospital       Hospital?       @relation(fields: [hospitalId], references: [id])
  surgery        Surgery?        @relation(fields: [surgeryId], references: [id])
  assignedUser   User?           @relation(fields: [assignedUserId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([city])
  @@index([assignedUserId])
}

model Document {
  id        String   @id @default(cuid())
  name      String
  type      String
  url       String
  leadId    String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  name           String
  role           String        @default("admin")
  createdAt      DateTime      @default(now())
  lastActiveAt   DateTime?
  dailyCallQuota Int           @default(50)
  assignedLeads  Lead[]
  activityLogs   ActivityLog[]
}

model PartnerRequest {
  id                 String        @id @default(cuid())
  hospitalName       String
  registrationNumber String
  city               String
  state              String
  pincode            String
  contactPerson      String
  designation        String
  email              String
  phone              String
  website            String?
  hospitalType       String[]
  specialties        String[]
  bedCapacity        Int
  icuBeds            Int?
  hasOT              Boolean
  yearsInOperation   Int
  isNABH             Boolean       @default(false)
  isJCI              Boolean       @default(false)
  isISO              Boolean       @default(false)
  has24x7Emergency   Boolean       @default(false)
  hasAmbulance       Boolean       @default(false)
  hasPharmacy        Boolean       @default(false)
  hasDiagnosticLab   Boolean       @default(false)
  hasBloodBank       Boolean       @default(false)
  partnershipReason  String
  monthlyPatients    Int?
  insuranceTieups    String?
  status             PartnerStatus @default(PENDING)
  referenceId        String        @unique
  comments           String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model SocialPost {
  id           String    @id @default(cuid())
  content      String
  platform     String
  status       String    @default("PENDING")
  publishedAt  DateTime?
  surgeryId    String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  surgery      Surgery?  @relation(fields: [surgeryId], references: [id])
}

model Appointment {
  id              String   @id @default(cuid())
  patientName     String
  patientPhone    String
  appointmentDate DateTime
  reason          String?
  status          String   @default("SCHEDULED")
  callTranscript  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

enum Category {
  GENERAL_SURGERY
  ORTHOPEDICS
  UROLOGY
  ENT
  GYNECOLOGY
  OPHTHALMOLOGY
  CARDIAC
  NEURO
  GASTRO
  DENTAL
  COSMETIC
  PEDIATRIC
  ONCOLOGY
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  ASSIGNED
  SCHEDULED
  COMPLETED
  CLOSED
  OPD_SCHEDULED
  OPD_DONE
  SURGERY_SCHEDULED
  SURGERY_DONE
  LOST
}

enum InsuranceOption {
  YES
  NO
  NOT_SURE
}

enum PartnerStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  ONBOARDED
}

model ActivityLog {
  id         String       @id @default(cuid())
  userId     String
  leadId     String?
  actionType ActivityType
  details    String?
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id])
  lead       Lead?        @relation(fields: [leadId], references: [id])

  @@index([userId])
  @@index([leadId])
  @@index([createdAt])
  @@index([actionType])
}

enum ActivityType {
  STATUS_CHANGED
  CALL_LOGGED
  NOTE_ADDED
  LEAD_ASSIGNED
  LOGIN
}
